# Copy to .env (scripts\dev.ps1 setup does this). Never commit .env.

# ---------------------------------------------------------------- ports
# Non-default host ports so nothing clashes with other local projects
# (those use 5432, 6379, 9092, 8000, 5173, 3000, 9090).
API_PORT=18000
WEB_PORT=15173
POSTGRES_PORT=15432
REDIS_PORT=16379
KAFKA_PORT=19092
KAFKA_UI_PORT=18090
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# ---------------------------------------------------------------- data stores
POSTGRES_USER=complaint
POSTGRES_PASSWORD=complaint_dev_pw
POSTGRES_DB=complaints
# The backend and scripts running on the host use these; containers override the host name.
DATABASE_URL=postgresql+asyncpg://complaint:complaint_dev_pw@localhost:15432/complaints
TEST_DATABASE_URL=postgresql+asyncpg://complaint:complaint_dev_pw@localhost:15432/complaints_test
REDIS_URL=redis://localhost:16379/0

# ---------------------------------------------------------------- AI
# LLM for the copilot: "mock" works offline with no key; "openai" uses the OpenAI API.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: request timeout (s), SDK retries for 429/5xx, and a proxy/compatible endpoint
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_BASE_URL=

# Hugging Face sentiment model (downloaded once into ml/.hf_cache)
SENTIMENT_MODEL=nlptown/bert-base-multilingual-uncased-sentiment

# Category predictions below this confidence are flagged "needs review"
REVIEW_THRESHOLD=0.45

# ---------------------------------------------------------------- attachments
# Ticket attachments are stored on local disk under a random name (default: var/attachments, gitignored).
# ATTACHMENTS_DIR=
MAX_ATTACHMENT_MB=10

# ---------------------------------------------------------------- routing (docs/ROUTING_RULES.md)
# Agents with this many open tickets get no more automatic assignments (the ticket waits in the team queue).
ROUTING_MAX_OPEN_PER_AGENT=25

# ---------------------------------------------------------------- retrieval (embeddings, similar tickets, KB, RAG)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector matches below these cosine similarities are dropped (tickets / help articles); keyword weight in the fusion
SIMILAR_MIN_SCORE=0.35
ARTICLE_MIN_SCORE=0.20
KEYWORD_WEIGHT=0.3
# References given to the copilot
RAG_SIMILAR_TICKETS=3
RAG_ARTICLES=2

# ---------------------------------------------------------------- events (Kafka KRaft, outbox, workers)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# "kafka": the API writes events to the outbox, the relay publishes them, workers consume them (dev, production).
# "inline": events are handled in the API process right after the commit (unit tests, demos without Kafka).
EVENTS_MODE=kafka
# Topic / consumer-group prefix, so several environments can share one broker (the e2e run uses "e2e").
EVENTS_PREFIX=complaints
# The LLM worker drafts the copilot answer as soon as triage finishes (set false to save API cost).
COPILOT_AUTO=true

# ---------------------------------------------------------------- SLA engine (docs/SLA.md)
# Demo speed-up for the workers: 120 makes the Critical 2-hour SLA lapse in one minute. 1 = real time.
SLA_SPEEDUP=1
# How often the SLA worker looks for warnings (80 %) and breaches (100 %)
SLA_SCAN_SECONDS=5

# ---------------------------------------------------------------- notifications
# Optional e-mail for escalations and SLA alerts (in-app notifications always work). Empty = no e-mail.
# The Compose "mailpit" service catches them locally: SMTP_HOST=localhost, SMTP_PORT=11025, inbox at :18025.
SMTP_HOST=
SMTP_PORT=11025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=Complaint Intelligence <alerts@shopzilla.example>
APP_BASE_URL=http://localhost:15173
