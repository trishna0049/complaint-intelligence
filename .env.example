# Copy to .env (scripts/dev.ps1 init does this for you). Never commit .env.

# ---------- Host ports (non-default to avoid clashing with other local stacks) ----------
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
KAFKA_HOST_PORT=19092
BACKEND_HOST_PORT=18000
FRONTEND_HOST_PORT=15173
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
MAILPIT_UI_HOST_PORT=18025

# ---------- Environment ----------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Database ----------
POSTGRES_USER=complaint
POSTGRES_PASSWORD=complaint_dev_password
POSTGRES_DB=complaint
# Inside docker the host is "postgres:5432"; from your machine use localhost:${POSTGRES_HOST_PORT}
DATABASE_URL=postgresql+asyncpg://complaint:complaint_dev_password@postgres:5432/complaint
TEST_DATABASE_URL=postgresql+asyncpg://complaint:complaint_dev_password@localhost:15432/complaint_test

# ---------- Redis / Kafka ----------
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173
COOKIE_SECURE=false

# ---------- Rate limits (requests per minute) ----------
RATE_LIMIT_DEFAULT=600
RATE_LIMIT_LOGIN=20
RATE_LIMIT_COPILOT=30

# ---------- AI / LLM ----------
# mock = realistic offline provider (no key needed); openai = real API with structured outputs
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Triage below this confidence goes to the human review queue instead of auto-routing
TRIAGE_REVIEW_THRESHOLD=0.40
SENTIMENT_MODEL=nlptown/bert-base-multilingual-uncased-sentiment
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- SLA ----------
# 1 = real time. 60 = one real second counts as one SLA minute (a 2h Critical SLA lasts 2 real minutes).
SLA_TIME_SCALE=1
SLA_SCAN_INTERVAL_SECONDS=10

# ---------- Email (optional) ----------
# Leave SMTP_HOST empty to disable email. "docker compose --profile mail up" starts Mailpit on SMTP mailpit:1025.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=alerts@complaint-intel.local

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_password

# ---------- Seed / demo ----------
SEED_ADMIN_EMAIL=admin@shopzilla.example
SEED_ADMIN_PASSWORD=Admin@12345
SEED_AGENT_PASSWORD=Agent@12345
# Shift imported 2023 timestamps so the newest record lands at import time (keeps dashboards live)
IMPORT_SHIFT_TO_NOW=true
