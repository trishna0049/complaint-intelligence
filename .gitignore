# --- Dataset (never committed) ---
data/*
!data/.gitkeep
!data/README.md

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Node ---
node_modules/
frontend/dist/
frontend/coverage/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/blob-report/

# --- Large ML artifacts (regenerated by ml/train_*.py) ---
ml/artifacts/*
!ml/artifacts/.gitkeep
ml/.hf_cache/
*.joblib
*.pt
*.bin
*.safetensors
*.onnx
*.parquet

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
