# --- Dataset (never committed) ---
data/*
!data/.gitkeep
!data/README.md

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# --- Node ---
node_modules/
frontend/dist/
.npm-cache/

# --- ML artifacts & model caches (regenerated by ml/*.py) ---
ml/artifacts/*
!ml/artifacts/.gitkeep
ml/.hf_cache/
*.joblib

# --- Runtime data (SQLite database) ---
var/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
